rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Player profiles (per-user saved data, e.g. high scores synced across devices) ----
    // A signed-in user may read/write only their own profile document.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rooms now live exclusively in RTDB. Denying unmatched paths retires
    // Firestore room access, including clients loaded before the migration.

    // ---- Admin roster ----
    // The admin list lives in a single config doc, readable AND writable only by
    // existing admins (bootstrap the first one in the Firebase console). No
    // identifiers sit in source; membership is keyed by Google email. Shape:
    //   config/admins = { members: { "<email>": { name: "<label>" } } }
    match /config/{doc} {
      allow read, write: if isOwner();
    }
    function isOwner() {
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.email_verified == true
             && exists(/databases/$(database)/documents/config/admins)
             && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.get('members', {});
    }

    // ---- Public announcements; drafts and publishing remain admin-only ----
    function validAnnouncement(data) {
      return data.keys().hasOnly(['title', 'body', 'game', 'important', 'published', 'revision', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'publishedAt'])
             && data.title is map && data.title.keys().hasOnly(['zh', 'en'])
             && data.body is map && data.body.keys().hasOnly(['zh', 'en'])
             && data.title.zh is string && data.title.en is string
             && data.body.zh is string && data.body.en is string
             && data.title.zh.size() <= 120 && data.title.en.size() <= 120
             && data.body.zh.size() <= 6000 && data.body.en.size() <= 6000
             && (data.title.zh.size() > 0 || data.title.en.size() > 0)
             && ((data.title.zh.size() > 0) == (data.body.zh.size() > 0))
             && ((data.title.en.size() > 0) == (data.body.en.size() > 0))
             && (data.game == null || (data.game is string && data.game.size() <= 80))
             && data.important is bool && data.published is bool
             && data.revision is int && data.revision > 0
             && data.updatedBy == request.auth.uid && data.updatedAt == request.time
             && (data.publishedAt == null || (data.publishedAt is timestamp && data.publishedAt <= request.time));
    }
    function indexedAnnouncement(id, data) {
      return getAfter(/databases/$(database)/documents/announcement_meta/index).data.versions.get(id, 0) == data.revision;
    }
    match /announcements/{id} {
      allow get: if isOwner() || resource.data.published == true;
      allow list: if request.query.limit != null && request.query.limit <= 50
                     && (resource.data.published == true || isOwner());
      allow create: if isOwner() && validAnnouncement(request.resource.data)
                       && request.resource.data.revision == 1
                       && request.resource.data.createdBy == request.auth.uid
                       && request.resource.data.createdAt == request.time
                       && ((request.resource.data.published == false && request.resource.data.publishedAt == null)
                           || (request.resource.data.published == true && request.resource.data.publishedAt == request.time && indexedAnnouncement(id, request.resource.data)));
      allow update: if isOwner() && validAnnouncement(request.resource.data)
                       && request.resource.data.createdBy == resource.data.createdBy
                       && request.resource.data.createdAt == resource.data.createdAt
                       && request.resource.data.revision == resource.data.revision + 1
                       && ((request.resource.data.published == true && resource.data.published == false
                            && request.resource.data.publishedAt == request.time)
                           || ((request.resource.data.published == false || resource.data.published == true)
                               && request.resource.data.publishedAt == resource.data.publishedAt))
                       && ((request.resource.data.published == true && indexedAnnouncement(id, request.resource.data))
                           || (request.resource.data.published == false
                               && (resource.data.published == false || !(id in getAfter(/databases/$(database)/documents/announcement_meta/index).data.versions))));
      allow delete: if isOwner() && resource.data.published == false;
    }
    match /announcement_meta/{id} {
      allow get: if id == 'index';
      allow create, update: if id == 'index' && isOwner()
                              && request.resource.data.keys().hasOnly(['versions', 'updatedAt'])
                              && request.resource.data.versions is map && request.resource.data.versions.size() <= 1000
                              && request.resource.data.updatedAt == request.time;
    }

    // ---- Private feedback and latest admin reply ----
    function signedAccount() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function ownFeedback(data) {
      return signedAccount() && data.get('uid', '') == request.auth.uid;
    }
    function validFeedbackCreate(data) {
      return request.auth != null
             && data.keys().hasOnly(['text', 'lang', 'kind', 'game', 'uid', 'name', 'email', 'anon', 'at', 'resolved', 'replyVersion', 'unread', 'adminUnread'])
             && data.uid == request.auth.uid
             && data.anon == (request.auth.token.firebase.sign_in_provider == 'anonymous')
             && data.email == request.auth.token.get('email', null)
             && (data.name == null || (data.name is string && data.name.size() <= 200))
             && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
             && data.lang in ['en', 'zh']
             && data.get('kind', null) in [null, 'idea', 'bug', 'other']
             && (data.get('game', null) == null || (data.game is string && data.game.size() <= 80))
             && data.at == request.time
             && data.get('resolved', false) == false
             && data.get('replyVersion', 0) == 0
             && data.get('unread', false) == false
             && data.get('adminUnread', true) == true;
    }
    match /feedback/{id} {
      allow create: if validFeedbackCreate(request.resource.data);
      allow get: if ownFeedback(resource.data) || isOwner();
      allow list: if request.query.limit != null && request.query.limit <= 100
                     && (ownFeedback(resource.data) || isOwner());
      allow delete: if isOwner();
      allow update: if (ownFeedback(resource.data)
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
                           && resource.data.get('replyVersion', 0) > 0
                           && resource.data.get('unread', false) == true
                           && request.resource.data.unread == false)
                       || (isOwner() && validAdminUpdate());
      function validAdminUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        return (changed.hasOnly(['resolved']) && data.resolved is bool)
               || (changed.hasOnly(['adminUnread']) && data.adminUnread == false)
               || (changed.hasOnly(['reply', 'replyVersion', 'unread'])
                   && data.replyVersion is int
                   && data.replyVersion == resource.data.get('replyVersion', 0) + 1
                   && data.unread == true
                   && data.reply is map
                   && data.reply.keys().hasOnly(['text', 'by', 'at'])
                   && data.reply.text is string
                   && data.reply.text.size() > 0 && data.reply.text.size() <= 2000
                   && data.reply.by == request.auth.uid
                   && data.reply.at == request.time);
      }
    }

  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Player profiles (per-user saved data, e.g. high scores synced across devices) ----
    // A signed-in user may read/write only their own profile document.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rooms now live exclusively in RTDB. Denying unmatched paths retires
    // Firestore room access, including clients loaded before the migration.

    // ---- Admin roster ----
    // The admin list lives in a single config doc, readable AND writable only by
    // existing admins (bootstrap the first one in the Firebase console). No
    // identifiers sit in source; membership is keyed by Google email. Shape:
    //   config/admins = { members: { "<email>": { name: "<label>" } } }
    match /config/{doc} {
      allow read, write: if isOwner();
    }
    function isOwner() {
      return request.auth != null
             && request.auth.token.email != null
             && exists(/databases/$(database)/documents/config/admins)
             && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.get('members', {});
    }

    // ---- Feedback box (drop box) ----
    // Anyone signed in (incl. anonymous) may submit a size-capped note. Only an owner
    // (see config/admins) may read, mark handled or delete them. Status updates may
    // change only the boolean resolved field; the original note stays intact.
    match /feedback/{id} {
      allow create: if request.auth != null
                       && request.resource.data.text is string
                       && request.resource.data.text.size() > 0
                       && request.resource.data.text.size() <= 2000
                       && request.resource.data.get('resolved', false) == false;
      allow read, delete: if isOwner();
      allow update: if isOwner()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
                       && request.resource.data.resolved is bool;
    }

  }
}

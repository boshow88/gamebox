rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Player profiles (per-user saved data, e.g. high scores synced across devices) ----
    // A signed-in user may read/write only their own profile document.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rooms now live exclusively in RTDB. Denying unmatched paths retires
    // Firestore room access, including clients loaded before the migration.

    // ---- Admin roster ----
    // The admin list lives in a single config doc, readable AND writable only by
    // existing admins (bootstrap the first one in the Firebase console). No
    // identifiers sit in source; membership is keyed by Google email. Shape:
    //   config/admins = { members: { "<email>": { name: "<label>" } } }
    match /config/{doc} {
      allow read, write: if isOwner();
    }
    function isOwner() {
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.email_verified == true
             && exists(/databases/$(database)/documents/config/admins)
             && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.get('members', {});
    }

    // ---- Private feedback and latest admin reply ----
    function signedAccount() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function ownFeedback(data) {
      return signedAccount() && data.get('uid', '') == request.auth.uid;
    }
    function validFeedbackCreate(data) {
      return request.auth != null
             && data.keys().hasOnly(['text', 'lang', 'kind', 'game', 'uid', 'name', 'email', 'anon', 'at', 'resolved', 'replyVersion', 'unread'])
             && data.uid == request.auth.uid
             && data.anon == (request.auth.token.firebase.sign_in_provider == 'anonymous')
             && data.email == request.auth.token.get('email', null)
             && (data.name == null || (data.name is string && data.name.size() <= 200))
             && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
             && data.lang in ['en', 'zh']
             && data.get('kind', null) in [null, 'idea', 'bug', 'other']
             && (data.get('game', null) == null || (data.game is string && data.game.size() <= 80))
             && data.at == request.time
             && data.get('resolved', false) == false
             && data.get('replyVersion', 0) == 0
             && data.get('unread', false) == false;
    }
    match /feedback/{id} {
      allow create: if validFeedbackCreate(request.resource.data);
      allow get: if ownFeedback(resource.data) || isOwner();
      allow list: if request.query.limit != null && request.query.limit <= 100
                     && (ownFeedback(resource.data) || isOwner());
      allow delete: if isOwner();
      allow update: if (ownFeedback(resource.data)
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
                           && resource.data.get('replyVersion', 0) > 0
                           && resource.data.get('unread', false) == true
                           && request.resource.data.unread == false)
                       || (isOwner() && validAdminUpdate());
      function validAdminUpdate() {
        let data = request.resource.data;
        let changed = data.diff(resource.data).affectedKeys();
        return (changed.hasOnly(['resolved']) && data.resolved is bool)
               || (changed.hasOnly(['reply', 'replyVersion', 'unread'])
                   && data.replyVersion is int
                   && data.replyVersion == resource.data.get('replyVersion', 0) + 1
                   && data.unread == true
                   && data.reply is map
                   && data.reply.keys().hasOnly(['text', 'by', 'at'])
                   && data.reply.text is string
                   && data.reply.text.size() > 0 && data.reply.text.size() <= 2000
                   && data.reply.by == request.auth.uid
                   && data.reply.at == request.time);
      }
    }

  }
}
